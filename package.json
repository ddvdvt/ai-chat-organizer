{
  "name": "ai-chat-organizer",
  "version": "1.0.0",
  "private": true,
  "description": "Органайзер ИИ-чатов — папки, поиск, экспорт (ChatGPT, Claude, Gemini)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:e2e": "node e2e/real-load.mjs && node e2e/smoke.mjs",
    "icons": "node scripts/make-icons.mjs",
    "locales": "node scripts/locales.src.mjs",
    "zip": "node scripts/pack.mjs",
    "store:images": "node scripts/store-images.mjs",
    "zip:firefox": "node scripts/firefox.mjs",
    "lint:firefox": "node scripts/firefox.mjs && web-ext lint --source-dir dist/firefox",
    "test:e2e:firefox": "node e2e/firefox-real-load.mjs && node e2e/firefox.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "puppeteer-core": "^25.16.0",
    "web-ext": "^10.8.0"
  }
}
